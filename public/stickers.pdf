  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --sat: env(safe-area-inset-top);
      --sar: env(safe-area-inset-right);
      --sab: env(safe-area-inset-bottom);
      --sal: env(safe-area-inset-left);
    }

    body {
      font-family: 'Inter', sans-serif;
      -webkit-tap-highlight-color: transparent;
      overscroll-behavior-y: none;
    }

    .safe-pb {
      padding-bottom: var(--sab);
    }

    .safe-pt {
      padding-top: var(--sat);
    }

    * {
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }
  </style>
  <script>
    tailwind.config = {
      darkMode: 'class'
    }
  </script>

  <link rel="stylesheet" href="/index.css">
  <script type="importmap">
{
  "imports": {
    "react": "https://esm.sh/react@^19.2.3",
    "react/": "https://esm.sh/react@^19.2.3/",
    "react-dom": "https://esm.sh/react-dom@^19.2.3",
    "react-dom/": "https://esm.sh/react-dom@^19.2.3/",
    "react-dom/client": "https://esm.sh/react-dom@^19.2.3/client"
  }
}
</script>
  <script type="module" crossorigin src="/assets/index-DQRNOnnj.js"></script>
</head>

<body class="overflow-x-hidden antialiased bg-slate-50 dark:bg-[#0f172a] transition-colors">
  <div id="root"></div>

  <!-- React Entry Point -->

  <script>
    // Force a deep purge if we add ?reset=true to the URL
    if (window.location.search.includes('reset=true')) {
      navigator.serviceWorker.getRegistrations().then(regs => regs.forEach(r => r.unregister()));
      localStorage.clear();
      sessionStorage.clear();
      indexedDB.databases().then(dbs => dbs.forEach(db => indexedDB.deleteDatabase(db.name)));
      window.location.href = window.location.origin;
    }

    // Commented out Service Worker for development to prevent caching old project credentials
    /*
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('./sw.js')
          .then(reg => console.log('Ice Vault Service Worker registered'))
          .catch(err => console.log('Service Worker registration failed', err));
      });
    }
    */
  </script>

</body>

</html>